<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 读取系统相册中的 JPEG / HEIF 等图片（Android 13+ 细分媒体权限） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14+（API 34）：用户仅授权"部分照片"时的访问权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <application
        android:name=".PixelCakeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PixelCake">

        <!--
          android:colorMode="hdr" 是广色域链路的第一环：
          请求系统以广色域（Display P3）合成并渲染该 Activity 的窗口。
          配合第 2 步的 RGBA16F 纹理与 EGL P3 配置，构成端到端广色域管线。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PixelCake"
            android:windowSoftInputMode="adjustResize"
            android:colorMode="hdr"
            android:screenOrientation="fullSensor"
            android:configChanges="colorMode|screenSize|smallestScreenSize|screenLayout|orientation|density|uiMode">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
